# ---- Story Director (Stage 1) ----
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- Illustrations (Stage 2) ----
# fal | replicate | mock
IMAGE_PROVIDER=fal
FAL_KEY=
REPLICATE_API_TOKEN=

# Optional Fal tuning (see src/config/imageModels.ts)
# FAL_MODEL=fal-ai/flux-general
# FAL_IP_ADAPTER_PATH=XLabs-AI/flux-ip-adapter
# FAL_IP_ADAPTER_ENCODER=openai/clip-vit-large-patch14
# FAL_NAG_SCALE=3
# FAL_REFERENCE_STRENGTH=0

# Optional Replicate tuning
# REPLICATE_MODEL=black-forest-labs/flux-1.1-pro
# REPLICATE_SAFETY_TOLERANCE=2

# Render queue
# RENDER_CONCURRENCY=3
# RENDER_MAX_ATTEMPTS=3

# Force every request onto the mock LLM + mock images (no credits used).
# Missing keys also fall back to mock automatically.
STORYFORGE_DEMO_MODE=false
